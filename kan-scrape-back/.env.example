# Copy to .env and adjust as needed. Everything has a working default —
# with no keys at all the app still boots (demo seed events only in dev).

APP_NAME='XXXXXX'
DEBUG=XXX
# File plus stderr. Empty = console only. Default: logs/kan-scrape.log
LOG_FILE=logs/kan-scrape.log
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=XXX

# --- LLM: matching + spoken pitch (Mistral, free tier) ---
# Without a key /match/* still answers, but always in mode="random".
MISTRAL_API_KEY=XXXXX
MISTRAL_CHAT_MODEL=XXXXX

# --- STT (local first, see docs/handoff-stt.md) ---
WHISPER_MODEL=XXXXX
# auto | cuda | mlx (Apple Silicon GPU; mps/metal are accepted aliases) | cpu
# auto = CUDA on Linux/Windows, MLX on Apple Silicon, CPU everywhere else.
WHISPER_DEVICE=XXXXX
WHISPER_COMPUTE_TYPE=XXXXX
# Only for the MLX backend: override the guessed mlx-community/whisper-<model> repo
MLX_WHISPER_REPO=XXXXX
# Start loading the model into VRAM as soon as the app boots (background, ~6s; poll
# /api/transcribe/status for readiness). false = lazy: the first transcription pays the load.
STT_WARMUP=XXXXX
# Max clip length in seconds; longer uploads get a 413
STT_MAX_SECONDS=XXXXX
# none | voxtral — opt-in remote fallback, only used when the local model fails
STT_FALLBACK=XXXXX

# --- TTS (edge-tts, no key needed, needs internet) ---
EDGE_TTS_VOICE=XXXXX

# --- Event sources (all optional) ---
# Fictional demo fixture; unset = follow DEBUG. Never enable in a real deployment.
SEED_EVENTS=XXXXX
DOORKEEPER_TOKEN=XXXXX
CONNPASS_API_KEY=XXXXX
# Comma-separated meetup.com group slugs; leave empty to scrape the full built-in list
MEETUP_GROUPS=XXXXX
HTTP_TIMEOUT_S=XXXXX
MAX_EVENTS_FOR_LLM=XXXXX
# Set false to run fully offline (seed only, no network on startup/refresh)
FETCH_REMOTE_SOURCES=XXXXX
