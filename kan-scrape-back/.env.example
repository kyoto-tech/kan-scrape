# Copy to .env and adjust as needed. Everything has a working default —
# with no keys at all the app still boots and serves the seed events.

APP_NAME="Kan Scrape API"
DEBUG=false
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# --- LLM: matching + spoken pitch (Mistral, free tier) ---
# Without a key /match/* still answers, but always in mode="random".
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest

# --- STT (local first, see docs/handoff-stt.md) ---
WHISPER_MODEL=large-v3-turbo
# auto | cuda | mlx (Apple Silicon GPU; mps/metal are accepted aliases) | cpu
# auto = CUDA on Linux/Windows, MLX on Apple Silicon, CPU everywhere else.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=
# Only for the MLX backend: override the guessed mlx-community/whisper-<model> repo
MLX_WHISPER_REPO=
# Load the model into VRAM during startup, before the server accepts requests (~6s).
# false = lazy: boots instantly, the first transcription pays the load instead.
STT_WARMUP=true
# Max clip length in seconds; longer uploads get a 413
STT_MAX_SECONDS=60
# none | voxtral — opt-in remote fallback, only used when the local model fails
STT_FALLBACK=

# --- TTS (edge-tts, no key needed, needs internet) ---
EDGE_TTS_VOICE=en-US-AvaMultilingualNeural

# --- Event sources (all optional; the seed source is always on) ---
DOORKEEPER_TOKEN=
CONNPASS_API_KEY=
MEETUP_GROUPS=kyoto-tech-meetup,osaka-international-friends,kyoto-hiking,kansai-hikers,kyoto-english-club,osaka-running-club
HTTP_TIMEOUT_S=10
MAX_EVENTS_FOR_LLM=40
# Set false to run fully offline (seed only, no network on startup/refresh)
FETCH_REMOTE_SOURCES=true
